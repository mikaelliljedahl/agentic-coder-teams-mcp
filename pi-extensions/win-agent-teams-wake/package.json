{
  "name": "win-agent-teams-wake",
  "version": "0.1.0",
  "private": true,
  "description": "Pi extension that wakes a team-lead Pi session when a worker posts to its win-agent-teams inbox, via a cursor-aware single-flight state machine.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check \"index.ts\" \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:write": "prettier --write \"index.ts\" \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
